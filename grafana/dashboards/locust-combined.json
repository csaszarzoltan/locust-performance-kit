{
  "title": "Locust Combined",
  "uid": "locust-combined",
  "tags": ["locust", "performance-testing", "observability"],
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "panels": [
    {
      "title": "Active Users",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(locust_users_swarm)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 }
    },
    {
      "title": "Total RPS",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(rate(locust_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "rps" } },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 }
    },
    {
      "title": "Service Graph",
      "type": "nodeGraph",
      "datasource": { "type": "tempo", "uid": "Tempo" },
      "targets": [{ "query": "{service.name=\"locust-performance-test\"}", "refId": "A" }],
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "Trace List",
      "type": "traceList",
      "datasource": { "type": "tempo", "uid": "Tempo" },
      "targets": [{ "query": "{service.name=\"locust-performance-test\"}", "refId": "A" }],
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode='idle'}[5m])) * 100)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 }
    },
    {
      "title": "Memory Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 }
    },
    {
      "title": "Network I/O",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "rate(node_network_receive_bytes_total[5m])", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 }
    }
  ],
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus" },
      { "name": "environment", "type": "constant", "query": "production", "hide": 2 }
    ]
  }
}
